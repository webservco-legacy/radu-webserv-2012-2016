<?xml version="1.0" encoding="UTF-8" ?>

<!-- Configuration -->
<config>
	<!-- Development Environment -->
	<dev>
		<!-- Users module settings -->
		<users>
			<form>
				<login>
					<email>
						<type>text</type>
						<title>Email</title>
						<description>Your email address</description>
						<required>1</required>
						<filters>StripTags</filters>
						<conditions>HasLengthMin[4]|HasLengthMax[48]</conditions>
					</email>
					<password>
						<type>password</type>
						<title>Password</title>
						<description>Your password</description>
						<required>1</required>
						<conditions>IsAlphanumeric|HasLengthMin[6]|HasLengthMax[20]</conditions>
					</password>
					
					<remember>
						<type>checkbox</type>
						<title>Remember me</title>
						<description>Check to stay logged in</description>
						<required>0</required>
					</remember>
					<send>
						<type>submit</type>
						<title></title>
						<content>Login</content>
					</send>
				</login>
			</form>
		</users>
	</dev>
