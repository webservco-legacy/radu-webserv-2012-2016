    <dev>
        <!-- User object settings -->
        <user>
            <login>
                <!-- Failed logins timeout (minutes) -->
                <timeout>5</timeout>
                <!-- Maximum failed login attempts permitted -->
                <attempts>10</attempts>
                <!-- Time after which the user is considered logged out -->
                <time>3</time>
