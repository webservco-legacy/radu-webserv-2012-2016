<config>
    <!-- Development Environment -->
    <dev>
        
    </dev>
    <!-- Test Environment -->
    <test></test>
    <!-- Production Environment -->
    <prod>
        <!-- User object settings -->
        <user>
            <login>
                <!-- Failed logins timeout (minutes) -->
                <timeout>5</timeout>
