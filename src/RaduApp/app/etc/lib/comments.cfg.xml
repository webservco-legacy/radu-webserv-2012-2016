<?xml version="1.0" encoding="UTF-8" ?>

<!-- Configuration -->
<config>
	<!-- Development Environment -->
	<dev>
	</dev>
	<!-- Test Environment -->
	<test>
	</test>
	<!-- Production Environment -->
	<prod>
		<!-- Comments library settings -->
		<comments>
		    <form>
		        <user>
		            <comment_name>
		                <type>text</type>
						<title>Name</title>
						<description></description>
						<required>1</required>
						<i18n></i18n>
						<filters>StripTags</filters>
						<conditions>HasLengthMin[2]</conditions>
		            </comment_name>
		            <comment_email>
		                <type>text</type>
						<title>Email</title>
						<description>Will not be published</description>
						<required>1</required>
						<i18n></i18n>
						<filters>StripTags</filters>
						<conditions>IsValidEmail|HasLengthMin[4]|HasLengthMax[90]</conditions>
		            </comment_email>
		            <comment_notify>
		                <type>checkbox</type>
						<title>Notify of replies</title>
						<description></description>
						<required></required>
						<i18n></i18n>
						<filters>StripTags</filters>
						<conditions></conditions>
		            </comment_notify>
		            <comment_content>
		                <type>textarea</type>
						<title>Comment</title>
						<description></description>
						<required>1</required>
						<i18n></i18n>
						<filters>StripTags</filters>
						<conditions>HasWordsMin[3]</conditions>
		            </comment_content>
		        </user>
		    </form>
		</comments>
	</prod>

</config>
